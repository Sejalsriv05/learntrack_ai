# LearnTrack AI Environment Configuration

# Backend Configuration
PROJECT_NAME="LearnTrack AI"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# Security
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (defaults to local SQLite file)
DATABASE_URL="sqlite+aiosqlite:///./learntrack.db"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
